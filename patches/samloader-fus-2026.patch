+""" FUS authentication functions (calculating auth token).
+
+2026 FUS scheme change: the server NONCE header is no longer encrypted, and the
+signature is a fixed-key AES-128-ECB block over the nonce, hex-encoded (was:
+CBC with a nonce-derived key, base64). Scheme taken from SamFirm_Reborn
+KiesAuth.cs. KEY_1/KEY_2/derive_key are dead under the new scheme but kept so
+older captures stay decodable.
+"""
 
 import base64
 from Cryptodome.Cipher import AES
 
-# Constant key input values.
+# Legacy constant key input values (pre-2026 scheme).
 KEY_1 = "hqzdurufm2c8mf6bsjezu1qgveouv7c7"
 KEY_2 = "w13r4cvf4hctaujv"
 
+# Current fixed AES-128-ECB signature key.
+AUTH_AES_KEY = bytes([0x42, 0x2e, 0x73, 0x73, 0x36, 0x17, 0xae, 0x2b,
+                      0x19, 0x89, 0x40, 0xfd, 0x4e, 0x32, 0xb0, 0xa5])
+
 # PKCS#7 padding functions.
 pkcs_unpad = lambda d: d[:-d[-1]]
 pkcs_pad = lambda d: d + bytes([16 - (len(d) % 16)]) * (16 - (len(d) % 16))
